{
  "name": "team-site-template",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "start": "bun run serve.ts",
    "publish": "bash ./publish.sh",
    "go-live": "bash ./go-live.sh",
    "db:setup": "bun run db/setup.ts",
    "sync-bids": "bun run src/jobs/runner.ts",
    "radar-alerts": "bun run src/jobs/send-radar-lead-alerts.ts",
    "sync-far": "bun run src/jobs/far-sync.ts",
    "check:routes": "bun run scripts/check-routes.mjs",
    "validate:live-sources": "STATE_GRANTS_RUN_LIVE_SOURCE_TESTS=1 bun test src/lib/state-grants/virginia.source-validation.test.ts",
    "test:state-grants:integration": "STATE_GRANTS_TEST_PROVISION_SCHEMA=1 bun test src/lib/state-grants",
    "typecheck": "tsc --noEmit -p tsconfig.prod.json",
    "test": "bun test",
    "format": "prettier --write .",
    "backfill-naics": "bun run src/jobs/backfill-naics.ts",
    "sync:state": "bun run src/jobs/state-grants-sync.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-router": "1.170.16",
    "@tanstack/react-start": "1.168.26",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "resend": "^6.18.1",
    "server-only": "^0.0.1",
    "stripe": "^22.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.7",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.0.5"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.23"
  },
  "packageManager": "bun@1.4.2"
}
